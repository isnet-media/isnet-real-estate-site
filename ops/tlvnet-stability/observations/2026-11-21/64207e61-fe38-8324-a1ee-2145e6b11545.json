    "candidate_patch": "--- a/lib/publication-evidence.mjs\n+++ b/lib/publication-evidence.mjs\n@@ -15,6 +15,17 @@\n  const proofs=rawProofs.flatMap(p=>{\n   if(p.published_verified===undefined)return [p]; // Established legacy receipt protocol.\n   const a=articles.find(a=>a.id===p.article_id),body=a&&createHash('sha256').update(a.body_html||'').digest('hex'),asset=a?.image_review?.asset_sha256;\n+  if(p.checks){\n+   // Local news has two nested receipt formats. Verify against current article bytes.\n+   const common=['title','image','jpg','credit','section_link','home_link'];\n+   const current=['body','lead','asset_sha256','license_link','neighborhood_links','collector_and_rights'];\n+   const legacy=['full_body','hash','license_if_applicable','collector','unblocked'];\n+   const verified=common.every(k=>p.checks[k]===true)\n+    &&(current.every(k=>p.checks[k]===true)||legacy.every(k=>p.checks[k]===true));\n+   if(p.published_verified!==true||entry.deployment_status!=='succeeded'||a?.section!=='news'||p.body_sha256!==body\n+    ||!(/^[a-f0-9]{64}$/.test(asset||''))||p.asset_sha256!==asset||p.url!=='https://tlvnet.com/news/'+a.id||!verified)return [];\n+   return [{article_id:p.article_id,url:p.url,full_body:true,title:true,credit:true,image_hash:true}];\n+  }\n   const references=(p.section_link===true&&p.home_link===true)||(p.section===true&&p.home===true);\n   const pairedAsset=p.asset_hash_matches===true&&p.asset_sha256_source===p.asset_sha256_public?p.asset_sha256_public:null;\n   const image=(p.image_hash===true&&p.image_src===true)||(p.asset_sha===true&&p.image===true)||(p.jpeg===true&&!!pairedAsset);\n--- a/tests/publication-evidence-receipt-shapes.mjs\n+++ b/tests/publication-evidence-receipt-shapes.mjs\n@@ -41,3 +41,28 @@\n  assert.equal(publicationEvidence(broken,[cultureArticle]).records[0].verificationRecorded,false);\n }\n console.log('PASS: nested culture receipts require matching body, image, section, homepage and terminal deployment');\n+\n+const localNews={...a,section:'news'};\n+const commonNews=['title','image','jpg','credit','section_link','home_link'];\n+for(const details of [\n+ ['body','lead','asset_sha256','license_link','neighborhood_links','collector_and_rights'],\n+ ['full_body','hash','license_if_applicable','collector','unblocked'],\n+]){\n+ const flags=[...commonNews,...details];\n+ const receipt={...economy,newPublishedArticleIds:['a'],deployment_status:'succeeded',public_verification:[{\n+  article_id:'a',url:p.url,published_verified:true,body_sha256:p.body_sha256,asset_sha256:p.asset_sha256,\n+  checks:Object.fromEntries(flags.map(k=>[k,true])),\n+ }]};\n+ assert.equal(publicationEvidence(receipt,[localNews]).records[0].outcome,'recorded_verified_new_publication');\n+ const withoutIds={...receipt,newPublishedArticleIds:[],existingPublicationsVerifiedCount:0};\n+ assert.equal(publicationEvidence(withoutIds,[localNews]).records[0].outcome,'recorded_verified_publication_kind_unspecified');\n+ for(const key of flags){\n+  const broken=structuredClone(receipt);\n+  broken.public_verification[0].checks[key]=false;\n+  assert.equal(publicationEvidence(broken,[localNews]).records[0].verificationRecorded,false,key);\n+ }\n+ assert.equal(publicationEvidence({...receipt,deployment_status:'failed'},[localNews]).records[0].verificationRecorded,false);\n+ assert.equal(publicationEvidence(receipt,[{...localNews,body_html:'changed'}]).records[0].verificationRecorded,false);\n+ assert.equal(publicationEvidence(receipt,[{...localNews,image_review:{asset_sha256:'0'.repeat(64)}}]).records[0].verificationRecorded,false);\n+}\n+console.log('PASS: both nested local-news receipts and fail-closed checks');\n",
