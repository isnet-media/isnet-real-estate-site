@@ -0,0 +1,36 @@
+"""Exercise the actual sitemap URL expression with Windows and POSIX paths."""
+import ast
+from pathlib import Path, PureWindowsPath, PurePosixPath
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+TREE = ast.parse((ROOT / 'scripts/build-stay.py').read_text(encoding='utf-8'))
+URLS = next(node.value for node in ast.walk(TREE)
+            if isinstance(node, ast.Assign)
+            and any(isinstance(t, ast.Name) and t.id == 'urls' for t in node.targets))
+CODE = compile(ast.Expression(URLS), 'build-stay.py:sitemap', 'eval')
+
+class Listing:
+    def __init__(self, pages):
+        self.pages = pages
+
+    def rglob(self, pattern):
+        assert pattern == 'index.html'
+        return iter(self.pages)
+
+class StaySitemapPortability(unittest.TestCase):
+    def test_real_url_expression_is_platform_independent(self):
+        for cls, root in [(PureWindowsPath, 'C:/site/public'),
+                          (PurePosixPath, '/site/public')]:
+            with self.subTest(platform=cls.__name__):
+                public = cls(root)
+                pages = [public / 'stay/day-fun/index.html',
+                         public / 'stay/places/the-norman/index.html']
+                urls = eval(CODE, {'PUBLIC': public, 'OUT': Listing(pages)})
+                self.assertEqual(urls, [
+                    'https://tlvnet.com/stay/day-fun/',
+                    'https://tlvnet.com/stay/places/the-norman/'])
+                self.assertTrue(all('\\' not in url for url in urls))
+
+if __name__ == '__main__':
+    unittest.main()
